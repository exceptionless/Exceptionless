---
title: Pricing
layout: layouts/base.vto
description: Simple Exceptionless pricing based on monthly events, not seats. The MCP server is on every plan; paid plans add real-time alerts, integrations, and Exie.
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">{{ icons.tag }} Pricing</p>
    <h1>Simple pricing that <span class="text-gradient">grows with you</span></h1>
    <p>Pay for the events you send, not the seats on your team. Every plan includes the full app and the MCP server for AI coding agents; paid plans add real-time alerts, integrations, longer retention, and Exie.</p>
    <div class="billing-toggle" role="group" aria-label="Billing period">
      <button type="button" data-billing="monthly" aria-pressed="true">Monthly</button>
      <button type="button" data-billing="yearly" aria-pressed="false">Yearly <span class="save">1 month free</span></button>
    </div>
  </div>
</section>

<section class="section-sm pricing-plans">
  <div class="container">
    <div class="plans">
      <div class="plan">
        <h2 class="plan-name">Free</h2>
        <p class="plan-tagline">For a single developer evaluating Exceptionless.</p>
        <div class="plan-price"><span class="amount">$0</span><span class="per">/month</span></div>
        <p class="plan-billed">No credit card required</p>
        <a class="btn btn-secondary" href="{{ site.signupUrl }}" data-cta="pricing-free">Get started</a>
        <ul>
          <li>{{ icons.check }}<span><strong>3,000</strong> events per month</span></li>
          <li>{{ icons.check }}<span><strong>3 days</strong> of retention</span></li>
          <li>{{ icons.check }}<span><strong>1</strong> project, <strong>1</strong> user</span></li>
          <li>{{ icons.plug }}<span><strong>MCP server</strong> for AI agents</span></li>
          <li class="is-muted">{{ icons.minus }}<span>Daily summary emails only</span></li>
        </ul>
      </div>

      <div class="plan">
        <h2 class="plan-name">Small</h2>
        <p class="plan-tagline">For small teams shipping a few apps.</p>
        <div class="plan-price"><span class="amount" data-monthly="$15" data-yearly="$13.75">$15</span><span class="per">/month</span></div>
        <p class="plan-billed" data-monthly="Billed monthly" data-yearly="Billed $165 yearly">Billed monthly</p>
        <a class="btn btn-secondary" href="{{ site.signupUrl }}" data-cta="pricing-small">Get started</a>
        <ul>
          <li>{{ icons.check }}<span><strong>15,000</strong> events per month</span></li>
          <li>{{ icons.check }}<span><strong>30 days</strong> of retention</span></li>
          <li>{{ icons.check }}<span><strong>5</strong> projects, <strong>10</strong> users</span></li>
          <li>{{ icons.check }}<span>Premium features</span></li>
          <li>{{ icons.plug }}<span><strong>MCP server</strong> for AI agents</span></li>
        </ul>
      </div>

      <div class="plan is-featured">
        <span class="plan-badge">Recommended</span>
        <h2 class="plan-name">Medium</h2>
        <p class="plan-tagline">For growing teams that want alerts, integrations, and AI help.</p>
        <div class="plan-price"><span class="amount" data-monthly="$49" data-yearly="$44.92">$49</span><span class="per">/month</span></div>
        <p class="plan-billed" data-monthly="Billed monthly" data-yearly="Billed $539 yearly">Billed monthly</p>
        <a class="btn btn-primary" href="{{ site.signupUrl }}" data-cta="pricing-medium">Get started</a>
        <ul>
          <li>{{ icons.check }}<span><strong>75,000</strong> events per month</span></li>
          <li>{{ icons.check }}<span><strong>90 days</strong> of retention</span></li>
          <li>{{ icons.check }}<span><strong>15</strong> projects, <strong>25</strong> users</span></li>
          <li>{{ icons.check }}<span>Premium features</span></li>
          <li>{{ icons["ai-sparkle"] }}<span><strong>Exie</strong> AI assistant</span></li>
          <li>{{ icons.plug }}<span><strong>MCP server</strong> for AI agents</span></li>
        </ul>
      </div>

      <div class="plan">
        <h2 class="plan-name">Large</h2>
        <p class="plan-tagline">For whole engineering teams.</p>
        <div class="plan-price"><span class="amount" data-monthly="$99" data-yearly="$90.75">$99</span><span class="per">/month</span></div>
        <p class="plan-billed" data-monthly="Billed monthly" data-yearly="Billed $1,089 yearly">Billed monthly</p>
        <a class="btn btn-secondary" href="{{ site.signupUrl }}" data-cta="pricing-large">Get started</a>
        <ul>
          <li>{{ icons.check }}<span><strong>250,000</strong> events per month</span></li>
          <li>{{ icons.check }}<span><strong>180 days</strong> of retention</span></li>
          <li>{{ icons.check }}<span><strong>Unlimited</strong> projects and users</span></li>
          <li>{{ icons.check }}<span>Premium features</span></li>
          <li>{{ icons["ai-sparkle"] }}<span><strong>Exie</strong> AI assistant</span></li>
          <li>{{ icons.plug }}<span><strong>MCP server</strong> for AI agents</span></li>
        </ul>
      </div>
    </div>

    <div class="plans-more">
      <div class="plan-row">
        <div>
          <h3>Extra Large</h3>
          <p>1,000,000 events per month, 180 days of retention, unlimited projects and users.</p>
        </div>
        <div class="plan-row-price">
          <strong data-monthly="$199" data-yearly="$182.42">$199</strong>
          <span data-monthly="per month" data-yearly="per month, billed yearly">per month</span>
        </div>
      </div>
      <div class="plan-row">
        <div>
          <h3>Enterprise</h3>
          <p>3,000,000 events per month, 180 days of retention, unlimited projects and users.</p>
        </div>
        <div class="plan-row-price">
          <strong data-monthly="$499" data-yearly="$457.42">$499</strong>
          <span data-monthly="per month" data-yearly="per month, billed yearly">per month</span>
        </div>
      </div>
      <div class="plan-row">
        <div>
          <h3>Self-hosted</h3>
          <p>Run it on your own infrastructure with no limits. You operate it; Apache 2.0 licensed.</p>
        </div>
        <div class="plan-row-price">
          <strong>Open source</strong>
          <span><a href="/docs/self-hosting/">Read the guide</a></span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="section-title">Compare plans</h2>
      <p class="section-lead">Every plan includes intelligent stacking, detailed event reports, logs, feature usage, sessions, and the full app.</p>
    </div>
    <div class="table-wrap reveal">
      <table class="compare-table">
        <thead>
          <tr>
            <th scope="col">Plan</th>
            <th scope="col">Free</th>
            <th scope="col">Small</th>
            <th scope="col">Medium</th>
            <th scope="col">Large</th>
            <th scope="col">Extra Large</th>
            <th scope="col">Enterprise</th>
          </tr>
        </thead>
        <tbody>
