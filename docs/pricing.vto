            <td>$0</td><td>$15</td><td>$49</td><td>$99</td><td>$199</td><td>$499</td>
          </tr>
          <tr>
            <th scope="row">Yearly price</th>
            <td>&mdash;</td><td>$165</td><td>$539</td><td>$1,089</td><td>$2,189</td><td>$5,489</td>
          </tr>
