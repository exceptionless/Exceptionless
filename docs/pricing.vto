            <td>3 days</td><td>30 days</td><td>90 days</td><td>180 days</td><td>180 days</td><td>180 days</td>
          </tr>
          <tr>
            <th scope="row">Projects</th>
            <td>1</td><td>5</td><td>15</td><td>Unlimited</td><td>Unlimited</td><td>Unlimited</td>
          </tr>
          <tr>
            <th scope="row">Users</th>
            <td>1</td><td>10</td><td>25</td><td>Unlimited</td><td>Unlimited</td><td>Unlimited</td>
          </tr>
          <tr class="group"><th scope="rowgroup" colspan="7">Features</th></tr>
          <tr>
            <th scope="row">Stacking, event details, logs, and sessions</th>
            <td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td>
          </tr>
          <tr>
            <th scope="row">Daily summary emails</th>
            <td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td>
          </tr>
          <tr>
            <th scope="row">Advanced search and custom filters</th>
            <td class="no">&mdash;</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td>
          </tr>
          <tr>
            <th scope="row">Real-time new, regression, and critical notifications</th>
            <td class="no">&mdash;</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td>
          </tr>
          <tr>
            <th scope="row">Slack, webhooks, and Zapier</th>
            <td class="no">&mdash;</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td>
          </tr>
          <tr>
            <th scope="row">Geolocation</th>
            <td class="no">&mdash;</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td>
          </tr>
          <tr>
            <th scope="row">MCP server for AI coding agents</th>
            <td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td>
          </tr>
          <tr>
            <th scope="row">Exie AI assistant</th>
            <td class="no">&mdash;</td><td class="no">&mdash;</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td><td>{{ icons.check }}</td>
          </tr>
        </tbody>
      </table>
