---
title: Contact
layout: layouts/base.vto
description: Contact the Exceptionless team, or get help through in-app support, GitHub Discussions, and GitHub Issues.
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">{{ icons["message-square"] }} Contact</p>
    <h1>Talk to the people who build it</h1>
    <p>Questions about hosted plans, self-hosting, support, or partnerships? Send us a message and the Exceptionless team will get back to you.</p>
  </div>
</section>

<div class="container">
  <div class="contact-layout">
    <form class="card contact-form" method="post" action="{{ site.appUrl }}/api/v2/contact" data-contact-form data-endpoint="{{ site.appUrl }}/api/v2/contact">
      <div class="form-grid">
        <div class="form-field">
          <label for="contact-name">Name</label>
          <input id="contact-name" name="Name" type="text" autocomplete="name" maxlength="100" required>
        </div>
        <div class="form-field">
          <label for="contact-email">Email</label>
          <input id="contact-email" name="EmailAddress" type="email" autocomplete="email" maxlength="254" required>
        </div>
        <div class="form-field">
          <label for="contact-company">Company</label>
          <input id="contact-company" name="Company" type="text" autocomplete="organization" maxlength="120">
        </div>
        <div class="form-field">
          <label for="contact-subject">Subject</label>
          <input id="contact-subject" name="Subject" type="text" maxlength="120">
        </div>
        <div class="form-field full">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="Message" rows="8" maxlength="4000" required></textarea>
        </div>
      </div>

      <div class="contact-honeypot" aria-hidden="true">
        <label for="contact-website">Website</label>
        <input id="contact-website" name="Website" type="text" tabindex="-1" autocomplete="off">
      </div>

      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Send message</button>
        <span class="contact-status" role="status" aria-live="polite" data-contact-status></span>
      </div>
    </form>

    <aside class="contact-aside" aria-label="Other ways to get help">
      <a class="card" href="{{ site.appUrl }}">
        <span class="feature-icon">{{ icons["message-square"] }}</span>
        <h3>In-app support</h3>
        <p>Have an account? Open <strong>Help &rarr; Support</strong> from your user menu to chat with us.</p>
      </a>
      <a class="card" href="{{ site.githubUrl }}/discussions">
        <span class="feature-icon">{{ icons.users }}</span>
        <h3>GitHub Discussions</h3>
        <p>Ask questions, get self-hosting help, and share ideas with the community.</p>
      </a>
      <a class="card" href="{{ site.githubUrl }}/issues">
        <span class="feature-icon">{{ icons.bug }}</span>
        <h3>GitHub Issues</h3>
        <p>Report a bug or request a feature in the open.</p>
      </a>
    </aside>
  </div>
</div>

<script>
(function () {
  var form = document.querySelector('[data-contact-form]');
  if (!form || !window.fetch) {
    return;
  }

  var status = form.querySelector('[data-contact-status]');
  var submit = form.querySelector('button[type="submit"]');

  function setStatus(message, isError) {
    status.textContent = message;
    status.className = isError ? 'contact-status is-error' : 'contact-status';
  }

  form.addEventListener('submit', function (event) {
    event.preventDefault();

    var formData = new FormData(form);
    var payload = {
      name: String(formData.get('Name') || ''),
      email_address: String(formData.get('EmailAddress') || ''),
      company: String(formData.get('Company') || ''),
      subject: String(formData.get('Subject') || ''),
      message: String(formData.get('Message') || ''),
      website: String(formData.get('Website') || '')
    };

    submit.disabled = true;
    setStatus('Sending...', false);

    fetch(form.getAttribute('data-endpoint'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
      credentials: 'omit'
    }).then(function (response) {
      if (response.ok) {
        form.reset();
        setStatus('Message sent. Thanks for reaching out.', false);
        return;
      }

      if (response.status === 429) {
        setStatus('Too many messages. Please try later.', true);
        return;
      }

      setStatus('We could not send your message. Please try later.', true);
    }).catch(function () {
      setStatus('We could not send your message. Please try later.', true);
    }).finally(function () {
      submit.disabled = false;
    });
  });
}());
</script>
