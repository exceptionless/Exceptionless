          "id": {
            "type": [
              "null",
              "string"
            ],
            "description": "The event id, when the event had one."
          },
          "code": {
            "type": "string",
            "description": "A stable machine-readable error code."
          },
          "message": {
            "type": "string",
            "description": "A description of the problem."
          }
        },
        "description": "Describes why one event was not processed."
      },
      "EventIngestionV3Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ],
            "description": "A client-generated identifier such as a UUID. Resending an event with the same id within the\nidempotency window acknowledges it as a duplicate instead of storing it twice."
          },
          "type": {
            "type": [
              "null",
              "string"
            ],
            "description": "The event type, such as error, log, usage, 404, or a custom type.\nDefaults to error when error information is present and log otherwise."
          },
          "date": {
            "type": [
              "null",
