            "items": {
              "type": "string"
            },
            "description": "Tags that categorize the event."
          },
          "version": {
            "type": [
              "null",
              "string"
            ],
            "description": "The application version that produced the event."
          },
          "level": {
            "type": [
              "null",
              "string"
            ],
            "description": "The log level, such as info or error."
          },
          "exception_type": {
            "type": [
              "null",
              "string"
            ],
            "description": "The runtime\u0027s exception type name. Used with stack_trace."
          },
          "stack_trace": {
            "type": [
              "null",
              "string"
            ],
            "description": "The runtime\u0027s original stack trace text. Used with exception_type."
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "A structured error with parsed stack frames, in the same format as the V2 \u0060@error\u0060 data\nvalue. Takes precedence over \u0060exception_type\u0060 and \u0060stack_trace\u0060.",
                "$ref": "#/components/schemas/Error"
              }
            ]
          },
          "stacking": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Overrides automatic grouping with a stack title and signature values.",
                "$ref": "#/components/schemas/ManualStackingInfo"
              }
            ]
          },
          "user": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The user that the event happened to.",
                "$ref": "#/components/schemas/UserInfo"
              }
            ]
          },
          "request": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The HTTP request that the event happened during.",
                "$ref": "#/components/schemas/RequestInfo"
              }
            ]
          },
          "environment": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The machine and process that produced the event.",
                "$ref": "#/components/schemas/EnvironmentInfo"
