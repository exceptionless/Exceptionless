        "type": "object",
        "properties": {
          "received": {
            "type": "integer",
            "description": "The number of events read from the request.",
            "format": "int32"
          },
          "persisted": {
            "type": "integer",
            "description": "Events that were stored.",
            "format": "int32"
          },
          "discarded": {
            "type": "integer",
            "description": "Events that were accepted but intentionally not stored, such as events for a discarded stack.",
            "format": "int32"
          },
          "duplicate": {
            "type": "integer",
            "description": "Events whose id was already received within the idempotency window.",
            "format": "int32"
          },
          "blocked": {
            "type": "integer",
            "description": "Events rejected because the organization reached its event limit.",
            "format": "int32"
          },
          "invalid": {
            "type": "integer",
            "description": "Events that could not be read or failed validation. Resending them unchanged fails again.",
            "format": "int32"
          },
          "failed": {
            "type": "integer",
            "description": "Events that failed because of a temporary server problem. Resend them.",
            "format": "int32"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventIngestionV3Error"
            },
            "description": "Details for up to the first 100 invalid or failed events."
          }
        },
        "description": "The outcome of a V3 ingestion request. Every received event is counted in exactly one outcome."
