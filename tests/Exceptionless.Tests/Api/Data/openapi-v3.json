          },
          "data": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {},
            "description": "Additional custom data. Values for the first-class properties above take precedence."
          }
        },
        "description": "One event submitted to the V3 ingestion API. Every property is optional; the smallest useful\nevent is {\u0022message\u0022:\u0022...\u0022}. Organization and project ownership come from the\nauthenticated request. Nested objects use the same shapes as the V2 event data values, so V2\nand V3 events are processed, grouped, and stored identically."
      },
      "EventIngestionV3Response": {
        "required": [
          "received",
          "persisted",
          "discarded",
          "duplicate",
          "blocked",
          "invalid",
          "failed",
          "errors"
