@apiUrl = http://localhost:7110/api/v2
@email = admin@exceptionless.test
@password = tester
@projectId = 537650f3b77efe23a47914f4
# Use a public HTTP(S) receiver. Private receivers require WebHooks:AllowedPrivateNetworks in server configuration.
@webhookUrl = https://example.com/exceptionless

### login to test account
# @name login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}"
}

###

@token = {{login.response.body.$.token}}

### Get Test Payloads
GET {{apiUrl}}/webhooks/test
Authorization: Bearer {{token}}

### Create a webhook for new and regressed errors
# @name newWebhook
POST {{apiUrl}}/webhooks
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "project_id": "{{projectId}}",
  "url": "{{webhookUrl}}",
  "event_types": ["NewError", "StackRegression"]
}

###

@webhookId = {{newWebhook.response.body.$.id}}

### Get By Project Id
GET {{apiUrl}}/projects/{{projectId}}/webhooks
Authorization: Bearer {{token}}

### Delete
DELETE {{apiUrl}}/webhooks/{{webhookId}}
Authorization: Bearer {{token}}
