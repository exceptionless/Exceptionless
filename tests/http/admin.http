@url = http://localhost:7110
@apiUrl = {url}/api/v2
@email = admin@exceptionless.test
@password = tester
@organizationId = 537650f3b77efe23a47914f3

### login to test account
# @name login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}"
}

###

@token = {{login.response.body.$.token}}

### Get Current User
# @name currentUser
GET {{apiUrl}}/users/me
Authorization: Bearer {{token}}

### Get OpenApi schema
# @name openapi
GET {{url}}/docs/v2/openapi.json

###
@userId = {{currentUser.response.body.$.id}}

### All Organizations
GET {{apiUrl}}/admin/organizations
Authorization: Bearer {{token}}

### Organizations By Criteria
GET {{apiUrl}}/admin/organizations?criteria=acme
Authorization: Bearer {{token}}

### Paid Organizations
GET {{apiUrl}}/admin/organizations?paid=true
Authorization: Bearer {{token}}

### Suspended Organizations
GET {{apiUrl}}/admin/organizations?suspended=true
Authorization: Bearer {{token}}

### Plan Stats
GET {{apiUrl}}/admin/organizations/stats
Authorization: Bearer {{token}}

### Exie Usage
GET {{apiUrl}}/admin/assistant-usage
Authorization: Bearer {{token}}

### Get Exie Settings
GET {{apiUrl}}/admin/assistant-settings
Authorization: Bearer {{token}}

### Set Exie Model Override
PUT {{apiUrl}}/admin/assistant-settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "model": "z-ai/glm-5.3-flash"
}

### Reset Exie Model Override
PUT {{apiUrl}}/admin/assistant-settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "model": null
}

### Disable Exie at Runtime
PUT {{apiUrl}}/admin/assistant-settings/enabled
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "enabled": false
}

### Reset Exie Availability to Deployment Default
PUT {{apiUrl}}/admin/assistant-settings/enabled
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "enabled": null
}

### Get Event Submission Settings
GET {{apiUrl}}/admin/event-submission-settings
Authorization: Bearer {{token}}

### Disable Event Submission at Runtime
PUT {{apiUrl}}/admin/event-submission-settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "enabled": false
}

### Reset Event Submission to Deployment Default
PUT {{apiUrl}}/admin/event-submission-settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "enabled": null
}

### Product Tour Usage
GET {{apiUrl}}/admin/product-tour-usage?month=2026-08-01&limit=100
Authorization: Bearer {{token}}

### Suspend
POST {{apiUrl}}/organizations/{{organizationId}}/suspend?code=1
Authorization: Bearer {{token}}
Content-Type: application/json

### Unsuspend
DELETE {{apiUrl}}/organizations/{{organizationId}}/suspend
Authorization: Bearer {{token}}

### Add Admin Role
POST {{apiUrl}}/users/{{userId}}/admin-role
Authorization: Bearer {{token}}
Content-Type: application/json

### Delete Admin Role
DELETE {{apiUrl}}/users/{{userId}}/admin-role
Authorization: Bearer {{token}}

### Requeue
GET {{apiUrl}}/admin/requeue?archive=true
Authorization: Bearer {{token}}

### Set Bonus
POST {{apiUrl}}/admin/set-bonus?organizationId={{organizationId}}&bonusEvents=1500&expires=12-31-2023
Authorization: Bearer {{token}}
Content-Type: application/json

### Update Organization Plans
GET {{apiUrl}}/admin/maintenance/update-organization-plans
Authorization: Bearer {{token}}

### Update Project Default Bot Lists
GET {{apiUrl}}/admin/maintenance/update-project-default-bot-lists
Authorization: Bearer {{token}}

### Fix Stack Stats (defaults: utcStart=now-90d, utcEnd=null=>now)
GET {{apiUrl}}/admin/maintenance/fix-stack-stats
Authorization: Bearer {{token}}

### Fix Stack Stats (explicit UTC window)
GET {{apiUrl}}/admin/maintenance/fix-stack-stats?utcStart=2026-02-10T00:00:00Z&utcEnd=2026-02-23T00:00:00Z
Authorization: Bearer {{token}}

### Admin Stats
GET {{apiUrl}}/admin/stats
Authorization: Bearer {{token}}

### Migrations
GET {{apiUrl}}/admin/migrations
Authorization: Bearer {{token}}

### Elasticsearch Cluster Info
GET {{apiUrl}}/admin/elasticsearch
Authorization: Bearer {{token}}

### Elasticsearch Snapshots
GET {{apiUrl}}/admin/elasticsearch/snapshots
Authorization: Bearer {{token}}
