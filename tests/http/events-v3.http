@apiUrl = http://localhost:7110/api/v3
@clientToken = LhhP1C9gijpSKCslHHCvwdSIz298twx271nTest
@projectId = 537650f3b77efe23a47914f4

### Send a single event
POST {{apiUrl}}/events
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "message": "Checkout started"
}

### Send an error with its stack trace
POST {{apiUrl}}/events
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "id": "4c0d8a5e-6f1b-4d3a-9b7e-2f6a1c9d8e01",
  "date": "2026-10-06T12:00:00Z",
  "message": "Payment declined",
  "exception_type": "PaymentError",
  "stack_trace": "PaymentError: Payment declined\n    at charge (/app/payments.js:42:7)",
  "version": "3.4.0",
  "tags": ["checkout"]
}

### Stream events as newline-delimited JSON
POST {{apiUrl}}/projects/{{projectId}}/events
Authorization: Bearer {{clientToken}}
Content-Type: application/x-ndjson

{"id":"4c0d8a5e-6f1b-4d3a-9b7e-2f6a1c9d8e02","type":"log","source":"Checkout","message":"Cart loaded","level":"info"}
{"id":"4c0d8a5e-6f1b-4d3a-9b7e-2f6a1c9d8e03","type":"usage","source":"checkout.submit"}

### Send a JSON array of events
POST {{apiUrl}}/events
Authorization: Bearer {{clientToken}}
Content-Type: application/json

[
  { "message": "First event" },
  { "message": "Second event" }
]
