<EmailSection Padding="0 0 16px">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="table-layout:fixed;width:100%">
        <tr>
            <td class="email-social-column" width="50%" valign="top" style="padding:0 8px 0 16px">
                <h5 style="@EmailStyles.Heading5;color:@EmailStyles.Dark">Connect With Us:</h5>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                    <tr><td style="padding-bottom:16px"><a href="https://www.facebook.com/exceptionless/" style="background:#3b5998;border-radius:3px;color:@EmailStyles.White;display:block;font-weight:700;padding:8px 16px;text-align:center;text-decoration:none">Facebook</a></td></tr>
                    <tr><td style="padding-bottom:16px"><a href="https://twitter.com/exceptionless" style="background:#1daced;border-radius:3px;color:@EmailStyles.White;display:block;font-weight:700;padding:8px 16px;text-align:center;text-decoration:none">Twitter</a></td></tr>
                    <tr><td><a href="https://github.com/exceptionless/exceptionless" style="background:#444;border-radius:3px;color:@EmailStyles.White;display:block;font-weight:700;padding:8px 16px;text-align:center;text-decoration:none">GitHub</a></td></tr>
                </table>
            </td>
            <td class="email-social-column" width="50%" valign="top" style="padding:0 16px 0 8px">
                <h5 style="@EmailStyles.Heading5;color:@EmailStyles.Dark">Contact Info:</h5>
                <p style="@EmailStyles.Paragraph">Email: <a href="mailto:support@exceptionless.io" style="@EmailStyles.Link">support@exceptionless.io</a></p>
            </td>
        </tr>
    </table>
</EmailSection>
