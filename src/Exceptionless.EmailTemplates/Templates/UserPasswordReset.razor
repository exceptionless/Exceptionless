@namespace Exceptionless.EmailTemplates.Templates
@inherits EmailTemplateComponent<UserPasswordResetEmail>

<EmailLayout Model="Model">
    <EmailSection>
        <h1 style="@EmailStyles.Heading1">Hello @Model.UserFullName,</h1>
        <p style="@EmailStyles.Lead">We heard you need a password reset. Click the link below and you'll be redirected to a secure site from which you can set a new password.</p>
        <EmailButton Url="@Model.Action!.Url">Reset Password</EmailButton>
        <p style="@EmailStyles.Paragraph">If you didn't try to reset your password, <a href="@Model.CancelUrl" style="@EmailStyles.Link">click here to cancel the password reset request</a> and we'll forget this ever happened.</p>
    </EmailSection>
</EmailLayout>
