@namespace Exceptionless.EmailTemplates.Templates
@inherits EmailTemplateComponent<UserEmailVerifyEmail>

<EmailLayout Model="Model">
    <EmailSection>
        @if (Model.IsNewAccount)
        {
            <h1 style="@EmailStyles.Heading1">Welcome, @Model.UserFullName!</h1>
            <p style="@EmailStyles.Lead">Your Exceptionless account is ready to use. Confirm your email address to finish setting it up and turn on email notifications.</p>
        }
        else
        {
            <h1 style="@EmailStyles.Heading1">Hello @Model.UserFullName,</h1>
            <p style="@EmailStyles.Lead">Confirm your email address to finish setting up your account and turn on email notifications.</p>
        }
        <EmailButton Url="@Model.Action!.Url">Confirm Email Address</EmailButton>
        <p style="@EmailStyles.Paragraph">This link expires in 24 hours.</p>
        @if (Model.IsNewAccount)
        {
            <p style="@EmailStyles.Paragraph"><strong>Next:</strong> <a href="@Model.AppUrl" style="@EmailStyles.Link">connect your app</a> to start capturing errors.</p>
            <p style="@EmailStyles.Paragraph">If you didn't create an Exceptionless account, you can ignore this email.</p>
        }
        else
        {
            <p style="@EmailStyles.Paragraph">If you didn't request this, you can ignore this email.</p>
        }
    </EmailSection>
</EmailLayout>
