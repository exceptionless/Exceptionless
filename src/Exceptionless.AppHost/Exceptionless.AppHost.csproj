<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>a9c2ddcc-e51d-4cd1-9782-96e1d74eec87</UserSecretsId>
    <NoWarn>$(NoWarn);ASPIRECERTIFICATES001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Browsers" Version="17.0.0-preview.1.26567.5" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="17.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Elasticsearch" Version="9.0.0" />
    <!-- Override Aspire's transitive dependency with a patched MessagePack release. -->
    <PackageReference Include="MessagePack" Version="3.1.12" />
  </ItemGroup>
</Project>
